	partition DimExchangeRates = m
		mode: import
		source =
				let
				    Source = Json.Document(Web.Contents("https://api.frankfurter.app/2023-01-01..2023-12-31", [Query=[from="USD", to="AUD,BRL,CAD,CNY,EUR,GBP,INR,JPY,MXN,NZD,ZAR"]])),
				    rates = Source[rates],
				    ToTable = Record.ToTable(rates),
				    RenameCols = Table.RenameColumns(ToTable, {{"Name", "Date"}, {"Value", "RatesRecord"}}),
				    ExpandRates = Table.ExpandRecordColumn(RenameCols, "RatesRecord", {"AUD","BRL","CAD","CNY","EUR","GBP","INR","JPY","MXN","NZD","ZAR"}),
				    Unpivot = Table.UnpivotOtherColumns(ExpandRates, {"Date"}, "Currency", "Rate"),
				    AddPair = Table.AddColumn(Unpivot, "CurrencyPair", each [Currency] & "USD"),
				    ChangedType = Table.TransformColumnTypes(AddPair,{{"Date", type date}, {"Rate", type number}}),
				    AddSK = Table.AddColumn(ChangedType, "exchange_rate_sk_pk", each Date.ToText([Date], "yyyyMMdd") & "_" & [CurrencyPair]),
				    Final = Table.SelectColumns(AddSK, {"exchange_rate_sk_pk", "Date", "Currency", "CurrencyPair", "Rate"})
				in
				    Final

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

